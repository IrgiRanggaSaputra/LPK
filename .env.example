# ==============================================================
# LPK Web Application - Docker Environment Configuration
# ==============================================================

# Database Configuration (MySQL)
DB_ROOT_PASSWORD=super_secret_root_password
DB_NAME=lpk
DB_USER=lpkuser
DB_PASSWORD=secret_db_password
DB_PORT=3306

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=lpkadmin123
ADMIN_SESSION_TOKEN=change_this_to_a_random_secure_token_in_production

# Notification & WhatsApp
ADMIN_EMAIL=admin_lpk@example.com
ADMIN_WA_NUMBER=6281234567890

# SMTP / Email Service (Optional for email alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Port exposure
FRONTEND_PORT=80

# Optional custom API URL (leave empty when using default Nginx reverse proxy)
VITE_API_URL=
BASE_URL=

